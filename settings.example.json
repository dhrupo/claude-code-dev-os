{
  "permissions": {
    "ask": ["Bash(git push:*)", "Bash(gh pr create:*)"]
  },
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "~/.claude/hooks/reminder.sh", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [{ "type": "command", "command": "~/.claude/hooks/scope-guard.sh", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "~/.claude/hooks/stop-check.sh", "timeout": 10 },
        { "type": "command", "command": "~/.claude/hooks/learn.sh", "timeout": 5 },
        { "type": "command", "command": "~/.claude/hooks/ctx-handoff.sh", "timeout": 5 }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "Skill", "hooks": [{ "type": "command", "command": "~/.claude/hooks/skill-log.sh", "timeout": 5 }] }
    ],
    "SessionStart": [
      { "matcher": "compact", "hooks": [{ "type": "command", "command": "~/.claude/hooks/compact.sh", "timeout": 5 }] }
    ]
  },
  "statusLine": { "type": "command", "command": "~/.claude/hooks/statusline.sh" }
}
